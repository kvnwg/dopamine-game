{
  "name": "dumpster-legend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim.ts",
    "cap:sync": "npm run build && cap sync",
    "android:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node tools/buildArtifact.mjs",
    "boot-art": "tsx tools/bootArt.ts",
    "dev:crazygames": "vite --host --mode crazygames",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames && node tools/crazygames/zip.mjs",
    "crazygames:covers": "node tools/crazygames/renderCovers.mjs && tsx tools/crazygames/renderLogo.ts",
    "crazygames:trailer": "node tools/crazygames/recordTrailer.mjs && node tools/crazygames/editTrailer.mjs",
    "crazygames:recut": "node tools/crazygames/editTrailer.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/pixelify-sans": "^5.3.0",
    "immer": "^11.2.9",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
